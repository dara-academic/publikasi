# ============================================================
# Konfigurasi server untuk despinurdara.id
# ============================================================

# Halaman 404 buatan sendiri
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Paksa HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Paksa tanpa www, supaya satu alamat saja yang dipakai
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Halaman yang sudah digabung, dialihkan permanen
  RewriteRule ^proses-terbit\.html$ /proses-review.html#menunggu-terbit [R=301,L]
  RewriteRule ^en/proses-terbit\.html$ /en/proses-review.html#menunggu-terbit [R=301,L]
</IfModule>

# Pemampatan
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Masa simpan di peramban
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Pengamanan dasar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Sembunyikan daftar isi folder
Options -Indexes
