# ============================================================
# Konfigurasi server untuk despinurdara.id
# ============================================================

# Halaman 404 buatan sendiri
ErrorDocument 404 /404.html

# Berkas kerja jangan sampai bisa dibuka publik.
# Ini penting kalau situs dipasang lewat Git deployment, karena isi repo
# ikut turun apa adanya ke public_html, termasuk berkas yang tidak ada
# urusannya dengan pengunjung.
<IfModule mod_authz_core.c>
  <FilesMatch "^(README\.md|\.gitignore|\.gitattributes|\.nojekyll|\.user\.ini|.*\.py|.*\.zip|.*\.log)$">
    Require all denied
  </FilesMatch>

  # Berkas catatan kunjungan tidak boleh dibuka siapa pun lewat peramban
  <FilesMatch "\.tsv$">
    Require all denied
  </FilesMatch>
</IfModule>

# Seluruh isi folder .git tidak boleh terbaca dari luar
RedirectMatch 404 /\.git
RedirectMatch 404 ^/data/

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Paksa HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Paksa tanpa www, supaya satu alamat saja yang dipakai
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Halaman yang sudah digabung, dialihkan permanen
  RewriteRule ^proses-terbit\.html$ /proses-review.html#menunggu-terbit [R=301,L]

  # Beranda portal sempat berada di portal.html sebelum ditukar menjadi
  # halaman utama. Tautan yang sudah terlanjur beredar diarahkan ke akar,
  # bukan dibiarkan mati.
  RewriteRule ^portal\.html$ / [R=301,L]

  # Materi pindah ke folder per semester. Tautan PDF lama yang sudah
  # terlanjur dibagikan mahasiswa diarahkan ke lokasi barunya.
  RewriteRule ^assets/materi/(?!\d)([a-z-]+)/(.+\.pdf)$ /assets/materi/124/$1/$2 [R=301,L]

  # Versi Inggris dihentikan. Situs ini ditujukan untuk mahasiswa dan dosen di
  # Indonesia, jadi cermin berbahasa Inggris hanya menambah beban rawat dan
  # ruang server tanpa pembaca. Alamat lamanya diarahkan ke padanan Indonesia.
  RewriteRule ^en/scopus/?$ /scopus/ [R=301,L]
  RewriteRule ^en/scopus/(.+)$ /scopus/$1 [R=301,L]
  RewriteRule ^en/sinta/?$ /sinta/ [R=301,L]
  RewriteRule ^en/sinta/(.+)$ /sinta/$1 [R=301,L]
  RewriteRule ^en/buku/?$ /buku/ [R=301,L]
  RewriteRule ^en/index\.html$ /bedah-publikasi.html [R=301,L]
  RewriteRule ^en/tentang\.html$ /tentang.html [R=301,L]
  RewriteRule ^en/glosarium\.html$ /glosarium.html [R=301,L]
  RewriteRule ^en/kolaborasi\.html$ /kolaborasi.html [R=301,L]
  RewriteRule ^en/lesson-learned\.html$ /lesson-learned.html [R=301,L]
  RewriteRule ^en/menulis-per-bagian\.html$ /menulis-per-bagian.html [R=301,L]
  RewriteRule ^en/mulai-dari-sini\.html$ /mulai-dari-sini.html [R=301,L]
  RewriteRule ^en/panduan-jurnal\.html$ /panduan-jurnal.html [R=301,L]
  RewriteRule ^en/proses-review\.html$ /proses-review.html [R=301,L]
  RewriteRule ^en/tanya-jawab\.html$ /tanya-jawab.html [R=301,L]
  RewriteRule ^en/tips\.html$ /tips.html [R=301,L]
  RewriteRule ^en/?$ /bedah-publikasi.html [R=301,L]
  RewriteRule ^en/(.*)$ / [R=301,L]

  # Materi semester 123 dilepas dari situs. Halamannya diarahkan ke rak mata
  # kuliah, bukan dibiarkan mati, karena tautannya mungkin sudah dibagikan.
  RewriteRule ^mata-kuliah/(msdm-s1|msdm-s2|pemberhentian-pensiun-sdm)(\.html|/.*)?$ /mata-kuliah/ [R=301,L]
  RewriteRule ^assets/materi/123/.*$ /mata-kuliah/ [R=301,L]
</IfModule>

# Pemampatan
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Masa simpan di peramban
# Halaman HTML tidak boleh disimpan browser tanpa dicek ulang. Sebelumnya
# disimpan satu jam, sehingga setiap pembaruan baru terlihat oleh pengunjung
# lama sampai satu jam kemudian, dan itu berkali-kali membuat perubahan yang
# sudah naik dikira belum naik. Berkas gambar, CSS, dan PDF tetap disimpan lama
# karena nama rujukannya sudah dibubuhi sidik isi, jadi berkas yang berubah
# otomatis punya alamat baru dan tidak mungkin tertukar dengan versi lama.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Pengamanan dasar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Sembunyikan daftar isi folder
Options -Indexes
